// 型の検査: src/ の .ts を strict で検査する
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // Node は型を消すだけで変換しないので、消すだけで動く書き方にそろえる（enum・namespace などを使わない、型は import type）
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./**/*.ts"]
}
